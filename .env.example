APP_NAME=EFT Company Matcher
APP_DATA_SOURCE=postgres
ALLOW_CSV_FALLBACK=true

# Replace YOUR_DB_PASSWORD in both settings with the same PostgreSQL password.
# In DATABASE_URL, URL-encode special characters in the password.
# In POSTGRES_PASSWORD, use the original password without URL encoding.
DATABASE_URL=postgresql+psycopg://eft_user:YOUR_DB_PASSWORD@127.0.0.1:5432/eft_matcher
POSTGRES_PASSWORD='YOUR_DB_PASSWORD'
